---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const pages = [
  { slug: 'new-york-times',  displayName: 'The New York Times'   },
  { slug: 'world-bank',      displayName: 'The World Bank Group' },
  { slug: 'self',            displayName: 'Independent Work'     },
];
---

<Layout title="Client Portfolios | Pierre Kattar">
  <Header />
  <main style="min-height:100vh;padding:9rem 2rem 5rem;">
    <div style="max-width:600px;margin:0 auto;">

      <h1 style="font-family:Arial,Helvetica,sans-serif;font-size:1rem;letter-spacing:0.3em;color:rgba(255,255,255,0.55);text-transform:uppercase;margin-bottom:3rem;">Client Portfolios</h1>

      <div style="display:flex;flex-direction:column;">
        {pages.map(p => (
          <a
            href={`/clients/${p.slug}`}
            style="display:block;padding:1.25rem 0;border-bottom:1px solid rgba(255,255,255,0.08);font-family:Arial,Helvetica,sans-serif;font-size:1.1rem;color:rgba(255,255,255,0.8);text-decoration:none;transition:color 0.2s;"
            onmouseover="this.style.color='#fff'"
            onmouseout="this.style.color='rgba(255,255,255,0.8)'"
          >
            {p.displayName}
          </a>
        ))}
      </div>

    </div>
  </main>
  <Footer />
</Layout>
